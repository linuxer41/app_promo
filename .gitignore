# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Editores
.vscode/
.idea/
*.suo
*.user

# Logs / temporales
*.log
npm-debug.log*
.tmp/
tmp/
*.tmp

# Dependencias (si algún día se usa Node)
node_modules/

# Configuración local de editores/agentes (contiene tokens)
.opencode/
opencode.json

# Capturas y vídeos exportados por las promos
resto-*.png
resto-*.jpg
facturgest-*.png
facturgest-*.jpg
# Los .mp4 finales van al repo; los .webm no, son el volcado del MediaRecorder
# antes del remux a h264 (≈35 MB cada uno) y se regeneran con record.mjs.
resto/video-out/*
facturgest/video-out/*
!resto/video-out/*.mp4
!facturgest/video-out/*.mp4

# Fuentes de diseño pesados: GitHub corta la subida por HTTPS/SSH alrededor de
# los 50 MB, así que estos archivos se quedan solo en disco.
*.psd
*.ai
*.sketch
